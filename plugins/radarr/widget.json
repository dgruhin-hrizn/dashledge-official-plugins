{
  "apiVersion": 2,
  "id": "plugin.dashledge.radarr",
  "title": "Radarr",
  "description": "Your Radarr download queue with progress and time left, beside the movies coming out soon, with posters.",
  "version": "1.0.0",
  "category": "Music & media",
  "icon": "icon.svg",
  "license": "MIT",
  "homepage": "https://github.com/dgruhin-hrizn/dashledge-official-plugins/tree/main/plugins/radarr",
  "minAppVersion": "0.9.0",
  "view": {"entry": "view/index.html", "viewport": "native", "theme": true},
  "sources": {
    "min": 1,
    "max": 1,
    "auth": {"header": "X-Api-Key"},
    "test": ["api/v3/system/status"],
    "addressLabel": "Radarr URL",
    "addressPlaceholder": "http://radarr.local:7878/",
    "credentialLabel": "API key"
  },
  "displayName": {"serverField": "status.instanceName"},
  "permissions": ["images", "settings", "ui"],
  "images": ["api/v3/mediacover/*/*"],
  "settings": [
    {
      "id": "days",
      "label": "Days ahead",
      "type": "number",
      "min": 1,
      "max": 60,
      "step": 1,
      "default": 30,
      "help": "How far ahead Coming up looks, up to 60 days."
    },
    {
      "id": "releases",
      "label": "Release dates",
      "type": "multi",
      "options": [
        {"value": "cinema", "label": "In cinemas"},
        {"value": "digital", "label": "Digital"},
        {"value": "physical", "label": "Physical"}
      ],
      "default": ["*"],
      "help": "Which of a movie's release dates Coming up lists."
    },
    {
      "id": "first",
      "label": "In a small placement, show",
      "type": "choice",
      "options": [
        {"value": "auto", "label": "Queue while something downloads"},
        {"value": "queue", "label": "Queue"},
        {"value": "upcoming", "label": "Coming up"}
      ],
      "default": "auto",
      "help": "The other is a tap away."
    }
  ],
  "connector": {
    "entry": "connector.js",
    "commands": ["refresh", "search"],
    "storage": 262144
  }
}
