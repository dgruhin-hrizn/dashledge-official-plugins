{
  "apiVersion": 2,
  "id": "plugin.dashledge.weather-example",
  "title": "Weather (example)",
  "description": "Current conditions and the next 24 hours from Open-Meteo, for a place you choose. Dashledge's reference plugin.",
  "version": "1.1.0",
  "category": "Productivity",
  "icon": "icon.svg",
  "license": "MIT",
  "homepage": "https://github.com/dgruhin-hrizn/dashledge-official-plugins/tree/main/plugins/weather-example",
  "minAppVersion": "0.9.0",
  "view": {"entry": "view/index.html", "viewport": "native", "theme": true},
  "permissions": ["settings", "ui"],
  "settings": [
    {
      "id": "location",
      "label": "Location",
      "type": "text",
      "maxLength": 80,
      "default": "",
      "help": "A city or place, such as Chicago, Portland, OR or Paris, France. Coordinates like 41.88, -87.63 work too."
    },
    {
      "id": "units",
      "label": "Temperature",
      "type": "choice",
      "options": [
        {"value": "fahrenheit", "label": "Fahrenheit (°F)"},
        {"value": "celsius", "label": "Celsius (°C)"}
      ],
      "default": "fahrenheit"
    }
  ],
  "connector": {
    "entry": "connector.js",
    "hosts": ["https://api.open-meteo.com", "https://geocoding-api.open-meteo.com"],
    "commands": ["watch"],
    "storage": 65536
  }
}
